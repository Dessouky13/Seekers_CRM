# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://seekers:YOUR_DB_PASSWORD@localhost:5432/seekersai

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=your-256-bit-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# ── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Brevo SMTP ────────────────────────────────────────────
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-login@example.com
BREVO_SMTP_PASS=your-brevo-smtp-key
EMAIL_FROM=Team@seekersai.org
EMAIL_FROM_NAME=Seekers AI

# ── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=https://app.seekersai.org

# ── File Storage ──────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ── Redis (local) ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── App URL (for file serving) ────────────────────────────
API_BASE_URL=http://localhost:3000

# ── Notifications / Automation ───────────────────────────
AUTOMATION_API_KEY=replace-with-random-long-secret
LEAD_NO_RESPONSE_HOURS=48
STALE_LEAD_SWEEP_MINUTES=10

# ── Task Cleanup (OFF by default) ────────────────────────
# Permanently DELETE tasks completed more than N days ago. This is a hard
# delete — it cascades to subtasks, there is no archive and no undo, and the
# UI gives no warning that a finished task is about to vanish.
# Leave unset (or 0) to keep completed tasks forever. Only set this if you
# genuinely want scheduled destruction of task history.
TASK_AUTO_DELETE_DAYS=0
TASK_CLEANUP_SWEEP_MINUTES=60

# ── Daily Loop (Today screen + WhatsApp digest) ──────────
# A lead with no activity for this many days becomes a "stale" action.
WORKLIST_STALE_DAYS=7
# Audit page views before a lead is treated as hot.
WORKLIST_HOT_VIEWS=3
# Runway (days of un-contacted leads at the current send rate) below which the
# pipeline is flagged as starving.
SUPPLY_RUNWAY_WARN_DAYS=7

# Morning WhatsApp digest. OFF by default — turning it on makes the CRM fire
# `worklist.digest` webhooks, which n8n turns into real messages to real people.
DIGEST_ENABLED=false
DIGEST_HOUR=9
DIGEST_TZ=Africa/Cairo
DIGEST_CHECK_MINUTES=15

# ── AI Agents (OpenRouter) ───────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-replace-with-real-key
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_MODEL_HEAVY=anthropic/claude-3.5-haiku
OPENROUTER_SITE_URL=https://agency.seekersai.org
OPENROUTER_APP_NAME=Seekers AI OS

# ── Outreach Scheduler ───────────────────────────────────
# How often the outreach sweep checks for due sequence sends (minutes)
OUTREACH_SWEEP_MINUTES=5

# ── IMAP Mailbox (read + Sent append) ────────────────────
# Same mailbox credentials as SMTP above (BREVO_SMTP_USER / BREVO_SMTP_PASS).
IMAP_HOST=mail.privateemail.com
IMAP_PORT=993
# Folder used for IMAP-APPEND of sent mail ("Sent Items" on some servers)
SENT_FOLDER=Sent

# ── Inbox Poller ─────────────────────────────────────────
# How often the INBOX is scanned for lead replies + bounces (minutes).
# Replies pause the lead's sequences and notify the assignee; bounces are
# logged as `events` rows. Disabled automatically if IMAP creds are missing.
INBOX_POLL_MINUTES=2
